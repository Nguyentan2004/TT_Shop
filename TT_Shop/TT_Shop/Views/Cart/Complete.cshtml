@{
    ViewBag.Title = "Complete";
    Layout = "~/Views/Shared/_LayoutNoFooter.cshtml";
    var isPaid = ViewBag.IsPaid as bool? ?? false;
}

<div class="container-fluid p-4">
    <div class="card">
        <div class="card-header bg-warning text-white">
            <h4>Xác nhận thanh toán</h4>
        </div>
        <div class="card-body text-center">
            @if (isPaid)
            {
                <div class="alert alert-success">Thanh toán VNPay thành công! Mã giao dịch: @ViewBag.TransactionNo</div>
                <form method="post" action="@Url.Action("VNPayPayment", "Cart")">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-lg">Thanh toán qua VNPay</button>
                </form>
            }
            else
            {
                <div class="alert alert-danger">Thanh toán chưa thành công hoặc bị hủy. Vui lòng thử lại.</div>
                <a href="@Url.Action("Payment", "Cart")" class="btn btn-warning">Quay lại thanh toán</a>
            }
        </div>
    </div>
</div>

        [HttpPost]
        [ValidateAntiForgeryToken]
        public ActionResult Complete()
        {
            var cart = Session["Cart"] as List<CartItem>;
            if (cart == null || !cart.Any())
            {
                return RedirectToAction("Index", "Home");
            }

            // Tạo đơn hàng mới
            var order = new Order
            {
                user_id = (int)Session["user_id"], // Get the current user ID
                order_status = "Pending",
                total_amount = cart.Sum(item => item.Gia.GetValueOrDefault() * item.SoLuong.GetValueOrDefault()),
                order_date = DateTime.Now,
                shipping_address = "Địa chỉ giao hàng của bạn", // Lấy địa chỉ giao hàng
                updated_at = DateTime.Now
            };

            db.Orders.Add(order);
            db.SaveChanges();

            foreach (var item in cart)
            {
                var product = db.Products.Find(item.IdSanPham);
                if (product == null)
                {
                    return HttpNotFound("Không tìm thấy sản phẩm.");
                }

                if (product.stock < item.SoLuong)
                {
                    return new HttpStatusCodeResult(HttpStatusCode.BadRequest, $"Không đủ số lượng sản phẩm {product.name}.");
                }

                product.stock -= item.SoLuong;
                db.Entry(product).State = EntityState.Modified;

                var orderDetail = new Order_Details
                {
                    order_id = order.order_id,
                    product_id = item.IdSanPham,
                    quantity = item.SoLuong,
                    price = item.Gia
                };

                db.Order_Details.Add(orderDetail);
            }

            db.SaveChanges();

            // Sửa giá trị payment_method thành giá trị hợp lệ với CHECK constraint, ví dụ: "Banking"
            var payment = new Payment
            {
                order_id = order.order_id,
                payment_method = "Banking", // Đảm bảo giá trị này hợp lệ với constraint trong DB
                payment_status = "Completed",
                payment_date = DateTime.Now
            };

            db.Payments.Add(payment);
            try
            {
                db.SaveChanges();
            }
            catch (DbUpdateException ex)
            {
                var innerException = ex.InnerException?.InnerException?.Message;
            }

            Session["Cart"] = null;

            return View();
        }

        [HttpGet]
        public ActionResult CompleteConfirm()
        {
            var cart = Session["Cart"] as List<CartItem>;
            if (cart == null || !cart.Any())
            {
                ViewBag.Message = "Giỏ hàng của bạn đang trống hoặc đã được thanh toán.";
                ViewBag.IsSuccess = false;
                return View("CompleteConfirm");
            }

            // Tạo đơn hàng mới
            var order = new Order
            {
                user_id = (int)Session["user_id"],
                order_status = "Pending",
                total_amount = cart.Sum(item => item.Gia.GetValueOrDefault() * item.SoLuong.GetValueOrDefault()),
                order_date = DateTime.Now,
                shipping_address = "Địa chỉ giao hàng của bạn",
                updated_at = DateTime.Now
            };

            db.Orders.Add(order);
            db.SaveChanges();

            foreach (var item in cart)
            {
                var product = db.Products.Find(item.IdSanPham);
                if (product == null || product.stock < item.SoLuong)
                {
                    ViewBag.Message = $"Không đủ số lượng sản phẩm {item.TenSanPham}.";
                    ViewBag.IsSuccess = false;
                    return View("CompleteConfirm");
                }

                product.stock -= item.SoLuong;
                db.Entry(product).State = EntityState.Modified;

                var orderDetail = new Order_Details
                {
                    order_id = order.order_id,
                    product_id = item.IdSanPham,
                    quantity = item.SoLuong,
                    price = item.Gia
                };

                db.Order_Details.Add(orderDetail);
            }

            db.SaveChanges();

            // Sửa giá trị payment_method thành giá trị hợp lệ với CHECK constraint, ví dụ: "Banking"
            var payment = new Payment
            {
                order_id = order.order_id,
                payment_method = "Banking", // Đảm bảo giá trị này hợp lệ với constraint trong DB
                payment_status = "Completed",
                payment_date = DateTime.Now
            };

            db.Payments.Add(payment);
            db.SaveChanges();

            Session["Cart"] = null;
            ViewBag.Message = "Thanh toán thành công! Đơn hàng của bạn đã được ghi nhận.";
            ViewBag.IsSuccess = true;
            return View("CompleteConfirm");
        }

        private IEnumerable<CartItem> GetCartItems()
